# OS
.DS_Store

# Secrets
.env

# Dependencies
node_modules

# Build artifacts
dist/

# IDE files
*.code-workspace

# Claude Code — settings.json is shared and tracked; everything else is local
.claude/settings.local.json
.claude/worktrees/
.claude/.cc-writes/

# pnpm falls back to a store inside the repo when it cannot write the global
# one (a sandboxed install will do this). Never a source artifact.
.pnpm-store/

# Local dev scaffolding: a symlink to a corpus checkout for driving the
# diagnostics view without the file picker. Machine-specific.
#
# It must stay **out of `ui/public`**, which vite copies verbatim into `dist/`
# and `bin/deploy.sh` rsyncs to production — dereferencing the symlink on the
# way (#122). Ignoring it is not what keeps it out of the bundle; its location
# is. `ui/tests/publicDir.test.ts` is what holds that.
ui/proto-fixtures
